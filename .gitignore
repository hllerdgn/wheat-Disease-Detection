# ==========================================
# WHEAT DISEASE DETECTION PROJECT .gitignore
# ==========================================

# --- OS Generated Files ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# --- IDEs & Editors ---
.vscode/
.idea/
*.swp
*.swo
*.sublime-project
*.sublime-workspace

# --- Backend (BACKEND/) ---
__pycache__/
**/__pycache__/
*.py[cod]
**/*.py[cod]
*$py.class
**/*$py.class
BACKEND/*.so
BACKEND/.Python
BACKEND/build/
BACKEND/develop-eggs/
BACKEND/dist/
BACKEND/downloads/
BACKEND/eggs/
BACKEND/.eggs/
BACKEND/lib/
BACKEND/lib64/
BACKEND/parts/
BACKEND/sdist/
BACKEND/var/
BACKEND/wheels/
BACKEND/share/python-wheels/
BACKEND/*.egg-info/
BACKEND/.installed.cfg
BACKEND/*.egg
BACKEND/MANIFEST

# Virtual Environments
BACKEND/.venv/
BACKEND/venv/
BACKEND/ENV/
BACKEND/env/

# Jupyter Notebook
BACKEND/.ipynb_checkpoints/

# --- Models & Data ---
# Model logs and temporary results
BACKEND/models/logs/
BACKEND/results/
BACKEND/data/
BACKEND/logs/

# Exception: Keep configuration and mapping files
!BACKEND/models/*.json
!BACKEND/models/*.py
!BACKEND/models/__init__.py

# --- Frontend (FRONTEND/) ---
FRONTEND/node_modules/
FRONTEND/dist/
FRONTEND/dist-ssr/
FRONTEND/*.local
FRONTEND/.vercel
FRONTEND/.next/

# Logs
FRONTEND/npm-debug.log*
FRONTEND/yarn-debug.log*
FRONTEND/yarn-error.log*
FRONTEND/pnpm-debug.log*

# Environment Variables (IMPORTANT: Do not push secrets)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env*

# --- Misc & Backups ---
BACKEND/download_test.py
kaggle.json
*.zip
.coverage
.coverage.*
coverage.xml
htmlcov/
tests/coverage_html/
.pytest_cache/

